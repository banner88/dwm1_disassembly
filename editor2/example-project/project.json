  "scripts": [
   {
    "id": "arm_encounters",
    "comment": "Arms the random-encounter step counter on scroll/post-battle reload (KEY_LESSONS S11: script 0 does NOT run dependably at initial entry; gate/floor are pinned per-step in ASM via bank $71). write_ram writes the LOW byte.",
    "ops": [
     [
      "op",
      "write_ram2",
      "0xCA39",
      "0x04B0"
     ],
     [
      "end"
     ]
    ],
    "_comment": "S70v2 measured truth (PyBoy, both S69+S70 ROMs): the per-step handler drains 100/step \u2014 the old seed 100 armed a battle EVERY step (the '100=5 steps' note was wrong). $04B0=1200 = 12 steps between battles; write_ram2 is the vanilla 16-bit form (Healer post-battle uses it)."
   },
